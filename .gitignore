__pycache__/
*.py[cod]
HANDOFF.md
# Internal design specs, implementation plans, and superpowers workflow
# artifacts. Operator-local; not part of the public-facing documentation
# in `documentation/`. Keep on disk for development history.
docs/
.env
.env.local
*.egg-info/
dist/
build/
.venv/
venv/
messages/
transcripts/
recordings/
.worktrees/
.pytest_cache/

# Private per-business configs — only the public `example-*.yaml` templates
# are tracked. Any other YAML in config/businesses/ is operator-local.
config/businesses/*.yaml
!config/businesses/example-*.yaml

# Per-business calendar credentials (service-account keys, OAuth tokens, OAuth client JSON)
secrets/*
!secrets/.gitkeep

# Local-only VM provisioning scripts (reference the tenant slug; not for the public repo)
deploy/

# Last-good tenant config served by the platform (see receptionist/tenant_config).
config/platform-cache/
