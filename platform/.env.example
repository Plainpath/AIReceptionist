# Postgres connection string for the platform database.
DATABASE_URL=postgresql://platform:change-me@localhost:5432/platform
# Bearer tokens (32+ chars each, different from each other).
#   admin  - read/write tenants and config (import CLI, later the staff console)
#   worker - read-only ai_secretary config (the voice worker)
PLATFORM_ADMIN_TOKEN=
PLATFORM_WORKER_TOKEN=
# Bind address. Keep 127.0.0.1 unless a reverse proxy with TLS sits in front.
HOST=127.0.0.1
PORT=8787
